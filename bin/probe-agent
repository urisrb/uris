#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../config/environment"
require "net/http"
require "json"

MODELS = ARGV.reject { |a| a.start_with?("-") }
ORIGIN = ENV.fetch("OLLAMA_ORIGIN", "http://localhost:11434")
TURNS = Integer(ENV.fetch("PROBE_TURNS", 6))
ASK = ENV.fetch("PROBE_ASK", "Find invoice PDFs in my catalog, then tell me the total on the first one.")
# Stopping politely is not succeeding. The canned get_item is the only place this
# appears, so a run that never chained cannot say it.
WANTED = ENV.fetch("PROBE_WANTED", "4,200")

SYSTEM = <<~TEXT
  You are the uris catalog agent. Use the tools to answer. When you have enough, answer
  in one sentence and stop.
TEXT

# Answers stand in for the catalog, so a probe measures the model rather than the data.
# Ids are checked the way a real tool checks them: a model that cannot chain has no
# way to know one, and inventing it has to fail here exactly as it would in the app.
KNOWN_IDS = %w[itm_91 itm_92].freeze

def canned(name, arguments)
  case name
  when "search_items"
    { count: 2, items: [ { id: "itm_91", title: "acme-jan.pdf", kind: "pdf" },
                         { id: "itm_92", title: "acme-feb.pdf", kind: "pdf" } ] }
  when "get_item"
    id = arguments["id"].to_s
    return { error: "no item with id #{id.inspect}" } unless KNOWN_IDS.include?(id)

    { id: id, title: "acme-jan.pdf", total: "$4,200", vendor: "Acme" }
  when "list_resources"
    { resources: [ { id: "res_1", type: "s3", key: "bucket" } ] }
  else
    { ok: true }
  end
end

def tools
  Tool.all.map do |tool|
    {
      type: "function",
      function: {
        name: tool.tool_name,
        description: tool.description.to_s.strip[0, 400],
        parameters: tool.input_schema.to_h.deep_stringify_keys
      }
    }
  end
end

def ask(model, messages, tools)
  uri = URI("#{ORIGIN}/v1/chat/completions")
  request = Net::HTTP::Post.new(uri, "content-type" => "application/json")
  request.body = { model: model, stream: false, messages: messages, tools: tools }.to_json

  answered = Net::HTTP.start(uri.hostname, uri.port, read_timeout: 600) { |http| http.request(request) }
  body = JSON.parse(answered.body)

  raise body.dig("error", "message").to_s if body["error"]

  body.dig("choices", 0, "message")
end

def probe(model, tools)
  known = tools.map { |tool| tool.dig(:function, :name) }
  messages = [ { role: "system", content: SYSTEM }, { role: "user", content: ASK } ]
  calls = 0

  TURNS.times do |turn|
    message = ask(model, messages, tools)
    wanted = message["tool_calls"]

    if wanted.blank?
      said = message["content"].to_s.strip.tr("\n", " ")
      looks_like_a_call = said.include?("\"name\"") || said.start_with?("[{", "{\"")

      verdict = if looks_like_a_call then :as_text
                elsif said.include?(WANTED) then :answered
                else :gave_up
                end

      return [ verdict, calls, said[0, 70] ]
    end

    messages << message

    wanted.each do |call|
      name = call.dig("function", "name")
      calls += 1
      puts "      turn #{turn + 1}: #{known.include?(name) ? '' : 'UNKNOWN '}#{name}" \
           "(#{call.dig('function', 'arguments').to_s[0, 60]})"

      arguments = JSON.parse(call.dig("function", "arguments").to_s) rescue {}

      messages << { role: "tool", tool_call_id: call["id"].to_s, name: name,
                    content: canned(name, arguments).to_json }
    end
  end

  [ :ran_out, calls, "hit the #{TURNS}-turn cap" ]
end

abort "usage: bin/probe-agent MODEL [MODEL...]" if MODELS.empty?

built = tools
puts "#{built.size} tools, #{TURNS} turns, #{ORIGIN}"
puts

MODELS.each do |model|
  puts "  #{model}"

  verdict, calls, said = begin
    probe(model, built)
  rescue StandardError => e
    [ :error, 0, e.message[0, 70] ]
  end

  mark = verdict == :answered ? "PASS" : "FAIL"
  note = { answered: "chained #{calls} call(s) and answered",
           gave_up: "stopped after #{calls} call(s) without the answer",
           as_text: "emitted a call as text",
           ran_out: "never stopped", error: "error" }.fetch(verdict)

  puts "      #{mark}  #{note} — #{said}"
  puts
end
