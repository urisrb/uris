#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")
  system!("npm install")

  unless File.exist?(".env")
    puts "\n== Creating .env =="
    FileUtils.cp(".env.example", ".env")
  end

  puts "\n== Starting backing services =="
  system!("docker compose up -d --wait")

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:seed"

  puts "\n== Generating the API layer =="
  system! "bin/rails graphql:dump_schema"
  system! "npm run codegen"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  puts <<~NEXT

    Add these to /etc/hosts, then run bin/dev:

      127.0.0.1 things.test jons.things.test acme.things.test

      http://jons.things.test:4242
      http://acme.things.test:4242

  NEXT
end
