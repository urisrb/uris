#!/bin/bash
set -euo pipefail
trap 'kill 0' EXIT

export SHELL="${SHELL:-/bin/bash}"

bin/rails graphql:dump_schema
npm run codegen
npm run build:sdk

npx chokidar --polling 'app/graphql/**/*.rb' \
  -c 'bin/rails graphql:dump_schema && npm run codegen' &

npx chokidar --polling 'web/src/operations/**/*.graphql' \
  -c 'npm run codegen' &

npm run build:sdk:watch -- --watchFile dynamicPriorityPolling &

bin/vite dev &

wait -n
