name: items

services:
  items:
    image: "{{ things_image }}{{ '@' + things_image_digest if things_image_digest else ':' + things_image_tag }}"
    restart: unless-stopped
    environment:
      POSTGRES_HOST: "{{ things_postgres_host }}"
      POSTGRES_PORT: "{{ things_postgres_port }}"
      POSTGRES_USER: "{{ things_postgres_user }}"
      POSTGRES_PASSWORD: "{{ things_postgres_password }}"
      URIS_DATABASE_PASSWORD: "{{ things_postgres_password }}"
      OPENSEARCH_URL: http://opensearch:9200
      S3_ENDPOINT: http://minio:9000
      S3_REGION: "{{ things_s3_region }}"
      S3_ACCESS_KEY_ID: "{{ things_s3_access_key_id }}"
      S3_SECRET_ACCESS_KEY: "{{ things_s3_secret_access_key }}"
      MASKS_ISSUER_TEMPLATE: "{{ things_masks_issuer_template }}"
      URIS_PUBLIC_ORIGIN: "{{ things_public_origin }}"
      SECRET_KEY_BASE: "{{ things_secret_key_base }}"
      ENCRYPTION_PRIMARY_KEY: "{{ things_encryption_primary_key }}"
      ENCRYPTION_DETERMINISTIC_KEY: "{{ things_encryption_deterministic_key }}"
      ENCRYPTION_KEY_DERIVATION_SALT: "{{ things_encryption_key_derivation_salt }}"
      RAILS_ASSUME_SSL: "true"
      RAILS_FORCE_SSL: "true"
      RAILS_LOG_LEVEL: "{{ things_log_level }}"
      RAILS_MAX_THREADS: "{{ things_max_threads }}"
      WEB_CONCURRENCY: "{{ things_web_concurrency }}"
      ANALYSIS_CONCURRENCY: "{{ things_analysis_concurrency }}"
      BULK_CONCURRENCY: "{{ things_bulk_concurrency }}"
      SOLID_QUEUE_IN_PUMA: "true"
    volumes:
      - storage:/rails/storage
    depends_on:
      opensearch:
        condition: service_healthy
      minio:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost/up > /dev/null"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 90s
    networks:
      - "{{ things_network }}"

  opensearch:
    image: "{{ things_opensearch_image }}"
    restart: unless-stopped
    environment:
      discovery.type: single-node
      plugins.security.disabled: "true"
      bootstrap.memory_lock: "false"
      OPENSEARCH_JAVA_OPTS: "-Xms{{ things_opensearch_heap }} -Xmx{{ things_opensearch_heap }}"
    mem_limit: "{{ things_opensearch_memory }}"
    ulimits:
      memlock: -1
      nofile: 65536
    volumes:
      - opensearch:/usr/share/opensearch/data
    healthcheck:
      test: ["CMD-SHELL", "curl -fs localhost:9200/_cluster/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 40
      start_period: 60s
    networks:
      - "{{ things_network }}"

  minio:
    image: "{{ things_s3_image }}"
    restart: unless-stopped
    command: server /data
    environment:
      MINIO_ROOT_USER: "{{ things_s3_access_key_id }}"
      MINIO_ROOT_PASSWORD: "{{ things_s3_secret_access_key }}"
    volumes:
      - minio:/data
    healthcheck:
      test: ["CMD-SHELL", "mc ready local || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 20s
    networks:
      - "{{ things_network }}"

volumes:
  storage:
  opensearch:
  minio:

networks:
  {{ things_network }}:
    external: true
