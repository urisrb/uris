name: uris

x-uris-env: &uris-env
  POSTGRES_HOST: "{{ uris_postgres_host }}"
  POSTGRES_PORT: "{{ uris_postgres_port }}"
  POSTGRES_USER: "{{ uris_postgres_user }}"
  POSTGRES_PASSWORD: "{{ uris_postgres_password }}"
  URIS_DATABASE_PASSWORD: "{{ uris_postgres_password }}"
  OPENSEARCH_URL: http://opensearch:9200
  S3_ENDPOINT: http://minio:9000
  URIS_S3_ORIGINS: http://minio:9000
  URIS_FILESYSTEM_ROOT: "{{ uris_filesystem_root }}"
  URIS_FILESYSTEM_ROOTS: "{{ uris_filesystem_root }}"
  S3_REGION: "{{ uris_s3_region }}"
  S3_ACCESS_KEY_ID: "{{ uris_s3_access_key_id }}"
  S3_SECRET_ACCESS_KEY: "{{ uris_s3_secret_access_key }}"
  MASKS_ISSUER_TEMPLATE: "{{ uris_masks_issuer_template }}"
  URIS_PUBLIC_ORIGIN: "{{ uris_public_origin }}"
  SECRET_KEY_BASE: "{{ uris_secret_key_base }}"
  ENCRYPTION_PRIMARY_KEY: "{{ uris_encryption_primary_key }}"
  ENCRYPTION_DETERMINISTIC_KEY: "{{ uris_encryption_deterministic_key }}"
  ENCRYPTION_KEY_DERIVATION_SALT: "{{ uris_encryption_key_derivation_salt }}"
  RAILS_ASSUME_SSL: "true"
  RAILS_FORCE_SSL: "true"
  RAILS_LOG_LEVEL: "{{ uris_log_level }}"
  RAILS_MAX_THREADS: "{{ uris_max_threads }}"

services:
  uris:
    image: "{{ uris_image }}{{ '@' + uris_image_digest if uris_image_digest else ':' + uris_image_tag }}"
    restart: unless-stopped
    environment:
      <<: *uris-env
      WEB_CONCURRENCY: "{{ uris_web_concurrency }}"
    volumes:
      - storage:/rails/storage
      - "files:{{ uris_filesystem_root }}"
    depends_on:
      opensearch:
        condition: service_healthy
      minio:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "curl -fsS http://localhost/up > /dev/null"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 90s
    networks:
      - "{{ uris_network }}"

  # Analysis shells out to chromium, soffice and tesseract, any of which can
  # hold a core for minutes. Kept out of the process that answers requests so a
  # slow catalogue cannot starve the API, and so the two scale apart.
  worker:
    image: "{{ uris_image }}{{ '@' + uris_image_digest if uris_image_digest else ':' + uris_image_tag }}"
    restart: unless-stopped
    command: ["./bin/jobs"]
    environment:
      <<: *uris-env
      ANALYSIS_CONCURRENCY: "{{ uris_analysis_concurrency }}"
      BULK_CONCURRENCY: "{{ uris_bulk_concurrency }}"
    volumes:
      - storage:/rails/storage
      - "files:{{ uris_filesystem_root }}"
    depends_on:
      uris:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "pgrep -f bin/jobs > /dev/null"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 60s
    networks:
      - "{{ uris_network }}"

  opensearch:
    image: "{{ uris_opensearch_image }}"
    restart: unless-stopped
    environment:
      discovery.type: single-node
      plugins.security.disabled: "true"
      bootstrap.memory_lock: "false"
      OPENSEARCH_JAVA_OPTS: "-Xms{{ uris_opensearch_heap }} -Xmx{{ uris_opensearch_heap }}"
    mem_limit: "{{ uris_opensearch_memory }}"
    ulimits:
      memlock: -1
      nofile: 65536
    volumes:
      - opensearch:/usr/share/opensearch/data
    healthcheck:
      test: ["CMD-SHELL", "curl -fs localhost:9200/_cluster/health || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 40
      start_period: 60s
    networks:
      - "{{ uris_network }}"

  minio:
    image: "{{ uris_s3_image }}"
    restart: unless-stopped
    command: server /data
    environment:
      MINIO_ROOT_USER: "{{ uris_s3_access_key_id }}"
      MINIO_ROOT_PASSWORD: "{{ uris_s3_secret_access_key }}"
    volumes:
      - minio:/data
    healthcheck:
      test: ["CMD-SHELL", "mc ready local || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 20s
    networks:
      - "{{ uris_network }}"

volumes:
  storage:
  files:
  opensearch:
  minio:

networks:
  {{ uris_network }}:
    external: true
