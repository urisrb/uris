# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files — every host, domain, and credential arrives
# through one of these, which is what keeps bin/check-boundary meaningful.
/.env*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Node and Vite
/node_modules
/public/vite
/public/vite-dev
/public/vite-test

# Generated from the Ruby schema by `npm run codegen` — never edited by hand.
/web/schema.graphql
/web/src/generated
/web/dist

# Ignore key files for decrypting credentials and more.
/config/*.key

# A local reference corpus for exercising the analyzers by hand. Mostly binary
# and 30MB of it is one raw photo, so it lives on disk rather than in history.
/test/fixtures/corpus


.masks/
