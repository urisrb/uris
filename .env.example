# Copy to .env. Every host, domain, and credential in this app arrives through
# the environment — that is what keeps the boundary rule (bin/check-boundary)
# enforceable rather than aspirational.

# Tenants are addressed by subdomain, so the suffix is configuration, never a
# constant. Add matching entries to /etc/hosts:
#
#   127.0.0.1 things.test jons.things.test acme.things.test
#
THINGS_HOST_SUFFIX=things.test
PORT=4242

# 127.0.0.1, not localhost: localhost resolves to ::1 first on macOS, which is
# where a Homebrew Postgres listens — and then you are talking to the wrong
# database with the right port.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_USER=things
POSTGRES_PASSWORD=things
OPENSEARCH_URL=http://127.0.0.1:9201

# Only needed when the linked pg_dump is older than the server in compose.yml.
# On macOS with Homebrew: /opt/homebrew/opt/postgresql@17/bin
PG_BIN_PATH=

# The default storage resource. MinIO from compose.yml speaks the same s3
# dialect as R2, B2, Wasabi, and Garage — one adapter covers all of them.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=things-development
S3_ACCESS_KEY_ID=things
S3_SECRET_ACCESS_KEY=thingsthings

# Public origin for the MCP endpoint, when tunnelling to a client that cannot
# reach .test — a stable hostname, because OAuth redirect URIs register against
# it. Leave blank when not tunnelling.
THINGS_PUBLIC_ORIGIN=
