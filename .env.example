URIS_HOST_SUFFIX=uris.test
PORT=4242

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_USER=uris
POSTGRES_PASSWORD=uris
OPENSEARCH_URL=http://127.0.0.1:9201

# Colon-separated roots a filesystem resource may be rooted under. Unset means
# the type is unusable, which is the right default for a server holding more
# than one tenant's catalog.
# Stops every iteration job everywhere, for the operator rather than a tenant.
# Per-tenant and per-resource switches are rows in `gates`, set from the app.
URIS_ITERATORS_DISABLED=

URIS_FILESYSTEM_ROOTS=

URIS_INFERENCE_ORIGINS=http://127.0.0.1:11434

# Where the headless browser a web resource renders snapshots with lives. Unset
# means the usual places for the platform; unset and not installed means the
# type reports itself unusable rather than failing at capture time.
URIS_CHROME_PATH=

# Chrome's own sandbox is the last thing between a hostile page and the worker.
# Set only where the container cannot give it the namespaces it needs, and know
# that it is the guard you are turning off.
URIS_CHROME_NO_SANDBOX=

OLLAMA_URL=http://127.0.0.1:11434/v1
OLLAMA_FAST_MODEL=gemma3:4b
OLLAMA_SMART_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# How wide a vector the search index holds. The embedding model a tenant declares
# has to match it, and check_resource refuses one that does not. Changing it
# changes the mapping, so the index rebuilds itself and the catalog re-embeds.
URIS_EMBEDDING_DIMENSIONS=768

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=uris
S3_SECRET_ACCESS_KEY=urisuris

# Development values. Replace anywhere real credentials are stored:
# bin/rails db:encryption:init
ENCRYPTION_PRIMARY_KEY=dev_only_primary_key_not_for_real_credentials
ENCRYPTION_DETERMINISTIC_KEY=dev_only_deterministic_key_not_for_real_use
ENCRYPTION_KEY_DERIVATION_SALT=dev_only_key_derivation_salt_not_for_real

# Set when the linked pg_dump is older than the server in compose.yml,
# e.g. /opt/homebrew/opt/postgresql@17/bin
PG_BIN_PATH=

# Public origin for the MCP endpoint, when tunnelling to a client that cannot
# reach .test — a stable hostname, because OAuth redirect URIs register against
# it. Takes %{subdomain} where each tenant answers on its own host. Leave blank
# when not tunnelling.
URIS_PUBLIC_ORIGIN=

# The tenant's masks issuer, as a template over its subdomain. Tokens are rejected
# unless iss matches this and aud matches the tenant's own /mcp URL.
MASKS_ISSUER_TEMPLATE=http://%{subdomain}.auth.test:5555
